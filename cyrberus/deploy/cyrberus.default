# Cyrberus Head site settings.
# Installed once as /etc/default/cyrberus by deploy/install-head.sh and never
# overwritten after that. Read by cyrberus-scanner.service when it starts.
#
# Uncomment and change, then:   sudo systemctl restart cyrberus-scanner

# Name written into every manifest as head_id. For audit only - trust comes
# from the signing key, never from this name. One distinct name per Head.
#CYRBERUS_HEAD_ID=head-01

# How long a validated drive stays valid. The proposal and the manifest spec
# commit to 12 hours; change it only as a deliberate team decision.
#CYRBERUS_VALIDITY_HOURS=12
