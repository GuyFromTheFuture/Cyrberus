# Cyrberus is developed on Windows and runs on Linux. Without this,
# Git for Windows checks files out with CRLF line endings, and shell
# scripts and systemd units then fail on the Pi with errors like
#   /bin/bash^M: bad interpreter: No such file or directory
# Force LF for everything that Linux executes or parses.

* text=auto eol=lf

*.py        text eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.rules     text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows-side helpers keep CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Never touch these
*.png       binary
*.jpg       binary
*.pdf       binary
*.docx      binary
*.pem       binary
*.sig       binary
*.img       binary
