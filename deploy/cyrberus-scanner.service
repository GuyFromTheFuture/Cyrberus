# Cyrberus Head scanner daemon.
#
# Installed as /etc/systemd/system/cyrberus-scanner.service by
# deploy/install-head.sh. Started at power-on only when boot mode is on:
#     sudo bash /opt/cyrberus/deploy/boot-mode.sh on
#
# Logs:   journalctl -u cyrberus-scanner -f      (and /var/log/cyrberus/head.log)

[Unit]
Description=Cyrberus Head scanner daemon
Documentation=file:/opt/cyrberus/docs/SETUP_HEAD.md
# Wants, not Requires: if clamd is still loading or has failed, the Head still
# starts, shows "Virus list not ready yet", and refuses every drive (fail
# closed) until clamd answers. Requires= would leave the screen on
# "Checking is unavailable" with no explanation.
Wants=clamav-daemon.service
After=clamav-daemon.service systemd-tmpfiles-setup.service
# An appliance service never gives up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=cyrberus
Group=cyrberus
WorkingDirectory=/opt/cyrberus
Environment=PYTHONUNBUFFERED=1
# UTF-8 everywhere: filenames on drives are Unicode, and the NTFS helper
# (ntfs-3g) follows the locale when converting them.
Environment=LANG=C.UTF-8
# Optional site settings - CYRBERUS_HEAD_ID, CYRBERUS_VALIDITY_HOURS.
EnvironmentFile=-/etc/default/cyrberus
ExecStart=/opt/cyrberus/venv/bin/python3 /opt/cyrberus/head/daemon.py
Restart=always
RestartSec=3
# The daemon turns SIGTERM into a clean exit that unmounts any drive first.
TimeoutStopSec=20

# /run/cyrberus holds state.json, which the screen reads: readable by every
# account, writable only by this service (nothing in it is sensitive).
# Preserve: a daemon run by hand after `systemctl stop` can still use it.
RuntimeDirectory=cyrberus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Also re-owns any log file an earlier hand-run left behind.
LogsDirectory=cyrberus
LogsDirectoryMode=0750

# Hardening. The daemon calls `sudo mount`, which needs setuid, so
# NoNewPrivileges must stay off and capabilities cannot be dropped.
#   ProtectSystem=full  /usr, /boot and /etc read-only (not "strict": strict
#                       also freezes /run and /var, which sudo and mount write)
#   ReadOnlyPaths       the daemon cannot alter its own code or keys
# These give the service a private mount namespace: the scan mount is not
# visible from an SSH shell. See SETUP_HEAD.md, Troubleshooting.
NoNewPrivileges=no
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/cyrberus

[Install]
WantedBy=multi-user.target
